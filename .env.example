# =============================================================================
# SelfVault - Configuration
# =============================================================================
# Copiez ce fichier en .env et personnalisez selon vos besoins
#
# MODES DE DÉPLOIEMENT:
# =====================
# 1. Local (développement) : AUTH_PROVIDER=local + docker-compose.yml
# 2. Production (self-hosted) : AUTH_PROVIDER=local + docker-compose.prod.yml
# 3. Avec Supabase : AUTH_PROVIDER=supabase + clés Supabase configurées
# =============================================================================

# =============================================================================
# AUTHENTIFICATION
# =============================================================================
# Options: local | supabase
#
# - local: Auth auto-hébergé (JWT + bcrypt) - AUCUNE dépendance externe
#          Parfait pour une installation 100% privée
#
# - supabase: Supabase Auth (social login, verification email, etc.)
#             Requiert un projet Supabase configuré
AUTH_PROVIDER=local

# =============================================================================
# BASE DE DONNÉES - PostgreSQL
# =============================================================================
POSTGRES_USER=selfvault
POSTGRES_PASSWORD=changez-ce-mot-de-passe
POSTGRES_DB=selfvault

# URL de connexion (automatiquement construite dans docker-compose)
# Pour usage local hors Docker:
# DATABASE_URL=postgresql://selfvault:changez-ce-mot-de-passe@localhost:5432/selfvault

# =============================================================================
# STOCKAGE - MinIO (S3-compatible)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changez-ce-mot-de-passe-minio
S3_BUCKET=selfvault

# Port console MinIO (accès web pour gérer les fichiers)
MINIO_CONSOLE_PORT=9001

# =============================================================================
# SÉCURITÉ - JWT
# =============================================================================
# IMPORTANT: Générez une clé secrète forte (minimum 32 caractères)
# Commande: openssl rand -base64 64
JWT_SECRET=changez-cette-cle-secrete-jwt-minimum-32-caracteres

# =============================================================================
# FRONTEND
# =============================================================================
# Port d'accès au frontend
# - Développement: 5173 (Vite dev server)
# - Production: 80 (Nginx)
FRONTEND_PORT=80

# URL de l'API backend (vue depuis le navigateur)
# - Développement local: http://localhost:8080
# - Production avec domaine: https://api.votre-domaine.com
VITE_API_URL=http://localhost:8080

# =============================================================================
# LIMITES D'UPLOAD
# =============================================================================
# Taille max par fichier (50 MB par défaut)
MAX_UPLOAD_SIZE_BYTES=52428800

# Stockage max par utilisateur (5 GB par défaut)
MAX_STORAGE_PER_USER_BYTES=5368709120

# =============================================================================
# CORS
# =============================================================================
# Origines autorisées (séparées par des virgules)
# Ajoutez votre domaine en production
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80

# =============================================================================
# SUPABASE (uniquement si AUTH_PROVIDER=supabase)
# =============================================================================
# Décommentez et remplissez si vous utilisez Supabase
# SUPABASE_URL=https://votre-projet.supabase.co
# SUPABASE_ANON_KEY=votre-anon-key
# SUPABASE_SERVICE_KEY=votre-service-key

