# ==========================================
# SelfVault Frontend Configuration
# ==========================================

# API Backend
VITE_API_URL=http://localhost:8080

# Authentication Provider (optional - auto-detected from backend if not set)
# Options: supabase | local
# VITE_AUTH_PROVIDER=supabase

# Supabase (required only if AUTH_PROVIDER=supabase)
VITE_SUPABASE_URL=https://your_url_here.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here