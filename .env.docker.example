# =============================================================================
# SelfVault - Docker Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your deployment
#
# For 100% self-hosted (no Supabase):
#   AUTH_PROVIDER=local
#
# For Supabase authentication:
#   AUTH_PROVIDER=supabase
#   SUPABASE_URL=https://your-project.supabase.co
#   SUPABASE_ANON_KEY=your-anon-key
#   SUPABASE_SERVICE_KEY=your-service-key
# =============================================================================

# =============================================================================
# Authentication
# =============================================================================
# Options: local | supabase
# - local: Self-managed auth (JWT + bcrypt) - NO external dependencies
# - supabase: Supabase Auth (social login, email verification)
AUTH_PROVIDER=local

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_USER=selfvault
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=selfvault

# =============================================================================
# MinIO (S3-compatible storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-secure-minio-password
MINIO_CONSOLE_PORT=9001
S3_BUCKET=selfvault

# =============================================================================
# JWT Secret (REQUIRED - minimum 32 characters)
# =============================================================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-this

# =============================================================================
# Frontend URL
# =============================================================================
VITE_API_URL=http://localhost:8080
FRONTEND_PORT=80

# =============================================================================
# Upload Limits
# =============================================================================
# 50MB per file
MAX_UPLOAD_SIZE_BYTES=52428800
# 5GB per user
MAX_STORAGE_PER_USER_BYTES=5368709120

# =============================================================================
# CORS (comma-separated origins)
# =============================================================================
ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://your-domain.com

# =============================================================================
# Supabase Configuration (ONLY if AUTH_PROVIDER=supabase)
# =============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_KEY=your-supabase-service-key
